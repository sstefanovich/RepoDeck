{
  "name": "repodeck",
  "version": "0.1.0",
  "description": "A friendly Git GUI for working on several repos at once",
  "author": "sstefanovich",
  "main": "main.js",
  "private": true,
  "scripts": {
    "start": "node launch.js",
    "test": "node --test \"test/*.test.js\"",
    "test:ui": "node --test --test-concurrency=1 \"test/ui/*.test.js\"",
    "setup": "electron-builder --win --publish never",
    "setup:x64": "electron-builder --win nsis:x64 --publish never -c.nsis.artifactName=${productName}-Setup-${version}-x64.${ext}",
    "dist": "npm run setup",
    "pack": "electron-builder --win --dir --publish never",
    "check": "node --check main.js && node --check preload.js && node --check src/git.js && node --check src/claude.js && node --check src/ado.js && node --check src/github.js && node --check renderer/lib.js && node --check renderer/core.js && node --check renderer/sidebar.js && node --check renderer/repo.js && node --check renderer/branches.js && node --check renderer/history.js && node --check renderer/pull-requests.js && node --check renderer/repo-tabs.js && node --check renderer/workspace.js && node --check renderer/setup.js && node --check renderer/menus.js && node --check renderer/claude-panel.js && node --check renderer/app.js"
  },
  "engines": {
    "node": ">=22.12.0"
  },
  "devDependencies": {
    "electron": "^45.2.1",
    "electron-builder": "^26.18.1"
  },
  "dependencies": {
    "electron-updater": "^6.8.12"
  },
  "overrides": {
    "@electron/asar": "^4.3.1",
    "glob": "^14.0.3",
    "minimatch": "^11.0.4",
    "global-agent": "^4.1.6",
    "lodash.isequal": "npm:fast-deep-equal@^3.1.3",
    "electron-builder-squirrel-windows": "file:./build/unused-target",
    "dmg-builder": "file:./build/unused-target"
  },
  "build": {
    "appId": "com.repodeck.app",
    "productName": "RepoDeck",
    "files": [
      "main.js",
      "preload.js",
      "src/**",
      "renderer/**",
      "build/icon.png",
      "package.json"
    ],
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": ["x64", "arm64"]
        }
      ],
      "icon": "build/icon.png"
    },
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowToChangeInstallationDirectory": true,
      "shortcutName": "RepoDeck",
      "artifactName": "${productName}-Setup-${version}.${ext}",
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "runAfterFinish": true,
      "deleteAppDataOnUninstall": false
    }
  }
}
